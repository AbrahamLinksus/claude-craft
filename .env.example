# Dev-only variables. Craft needs no .env to run.
CRAFT_HOME=
CRAFT_PIPE=
CRAFT_LOG_LEVEL=info
# Dev only: the background worker's built entry file, instead of the packaged one.
CRAFT_DAEMON_ENTRY=
# Dev only: load the window from the dev server (e.g. http://localhost:8001) instead of the build.
CRAFT_RENDERER_URL=
# Only for live spike/contract tests; never read by the daemon at runtime.
ANTHROPIC_API_KEY=
